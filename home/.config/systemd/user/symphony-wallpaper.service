[Unit]
Description=Symphony wallpaper
PartOf=graphical-session.target symphony-desktop.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/awww-daemon --format argb
ExecStartPost=%h/.config/hypr/scripts/restore-wallpaper
Restart=on-failure
RestartSec=2

[Install]
WantedBy=symphony-desktop.target
