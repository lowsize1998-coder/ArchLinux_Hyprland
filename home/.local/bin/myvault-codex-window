#!/usr/bin/env python3
"""myvault-codex-cli: focus its existing window or launch one."""
import json
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import time

WINDOW_CLASS = "com.myvault.Codex"
WORKSPACE = Path.home() / "Documents/MyVault"

try:
    # Keep rapid repeated presses from opening duplicate windows during startup.
    lock_path = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "myvault-codex-window.lock"
    launch_lock = lock_path.open("a")
    try:
        fcntl.flock(launch_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(0)
    result = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True,
                            text=True, check=True, timeout=4)
    windows = json.loads(result.stdout)
    existing = next((w for w in windows if w.get("class") == WINDOW_CLASS), None)
    if existing:
        action = "hl.dsp.focus({window = " + json.dumps(f"address:{existing['address']}") + "})"
        subprocess.run(["hyprctl", "dispatch", action],
                       check=True, timeout=4)
    else:
        codex = shutil.which("codex") or str(Path.home() / ".local/bin/codex")
        process = subprocess.Popen(["ghostty", "--gtk-single-instance=false", f"--class={WINDOW_CLASS}",
                          f"--working-directory={WORKSPACE}", "-e", codex,
                          "--cd", str(WORKSPACE)], start_new_session=True,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            result = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True,
                                    text=True, check=True, timeout=4)
            if any(w.get("class") == WINDOW_CLASS for w in json.loads(result.stdout)):
                break
            if process.poll() is not None:
                raise RuntimeError("Ghostty завершился до открытия окна Codex")
            time.sleep(0.1)
        else:
            raise RuntimeError("Окно Codex не появилось за 8 секунд")
except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "Codex CLI", "Не удалось открыть окно; проверь hyprctl."], timeout=4)
    raise SystemExit(str(exc))
