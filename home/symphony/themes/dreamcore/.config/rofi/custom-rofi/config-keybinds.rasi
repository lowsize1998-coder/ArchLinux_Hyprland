
configuration {
    modes: "drun";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "";
    drun-display-format: "{name}";
    terminal: "ghostty";
    font: "JetBrainsMono Nerd Font 12";
}
* { background-color: transparent; text-color: #1B272C; selected: #DFEDC9; }
window { location: center; anchor: center; width: 480px; background-color: #86AD31; border: 2px; border-color: #FDE1BA; border-radius: 14px; }
mainbox { padding: 16px; spacing: 12px; children: [ "inputbar", "listview" ]; }
inputbar { padding: 12px; background-color: #FFE2E6; border-radius: 8px; children: [ "entry" ]; }
entry { placeholder: "Поиск"; placeholder-color: #2C4049; text-color: #1B272C; }
listview { lines: 7; columns: 1; spacing: 5px; fixed-height: true; scrollbar: false; }
element { padding: 10px; spacing: 12px; border-radius: 8px; }
element normal.normal, element normal.active, element normal.urgent,
element alternate.normal, element alternate.active, element alternate.urgent {
    background-color: transparent;
    text-color: #1B272C;
}
element selected.normal, element selected.active, element selected.urgent {
    background-color: #DFEDC9;
    text-color: #1B272C;
}
element-icon { size: 28px; }
element-text { vertical-align: 0.5; text-color: inherit; }

window { width: 75%; }
listview { lines: 14; }
