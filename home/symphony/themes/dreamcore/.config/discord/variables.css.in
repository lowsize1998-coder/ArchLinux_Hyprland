/* Dreamcore color tokens; generated from the shared palette. */
:root, .theme-dark, .theme-light, .theme-darker, .theme-midnight {
  --dc-background: $background;
  --dc-text: $text;
  --dc-secondary: $secondary_text;
  --dc-muted: $dim_text_on_blue;
  --dc-border: $border_color;
  --dc-hover: $hover_color;
  --dc-selected: $selected_color;
  --dc-accent: $accent;
  --dc-teal: $secondary_accent;
  --dc-ink: $ink;
  --dc-selection: $selection;

  --background-primary: var(--dc-background) !important;
  --background-secondary: var(--dc-background) !important;
  --background-secondary-alt: var(--dc-background) !important;
  --background-tertiary: var(--dc-background) !important;
  --background-floating: var(--dc-background) !important;
  --background-accent: var(--dc-selected) !important;
  --background-base-lowest: var(--dc-background) !important;
  --background-base-lower: var(--dc-background) !important;
  --background-base-low: var(--dc-background) !important;
  --background-surface-high: var(--dc-background) !important;
  --background-surface-higher: var(--dc-background) !important;
  --background-surface-highest: var(--dc-background) !important;
  --background-modifier-hover: var(--dc-hover) !important;
  --background-modifier-active: var(--dc-selected) !important;
  --background-modifier-selected: var(--dc-selected) !important;
  --background-modifier-accent: var(--dc-border) !important;
  --background-mod-subtle: var(--dc-hover) !important;
  --background-mod-normal: var(--dc-selected) !important;
  --background-mod-strong: var(--dc-selected) !important;
  --background-mentioned: color-mix(in srgb, $accent 14%, transparent) !important;
  --background-mentioned-hover: color-mix(in srgb, $accent 22%, transparent) !important;
  --background-message-hover: var(--dc-hover) !important;
  --channeltextarea-background: var(--dc-hover) !important;
  --chat-background: var(--dc-background) !important;
  --chat-background-default: var(--dc-background) !important;
  --chat-border: var(--dc-border) !important;
  --modal-background: var(--dc-background) !important;
  --modal-footer-background: var(--dc-background) !important;
  --input-background: var(--dc-hover) !important;
  --input-border: var(--dc-border) !important;
  --autocomplete-bg: var(--dc-background) !important;
  --app-frame-background: var(--dc-background) !important;
  --app-frame-border: var(--dc-border) !important;
  --home-background: var(--dc-background) !important;
  --card-background-default: var(--dc-background) !important;
  --card-border-default: var(--dc-border) !important;
  --card-primary-pressed-bg: var(--dc-selected) !important;
  --card-secondary-bg: var(--dc-hover) !important;
  --card-secondary-pressed-bg: var(--dc-selected) !important;
  --embed-background-alternate: var(--dc-hover) !important;

  --text-normal: var(--dc-text) !important;
  --text-primary: var(--dc-text) !important;
  --text-default: var(--dc-text) !important;
  --text-secondary: var(--dc-secondary) !important;
  --text-muted: var(--dc-secondary) !important;
  --text-tertiary: var(--dc-muted) !important;
  --text-strong: var(--dc-text) !important;
  --text-subtle: var(--dc-secondary) !important;
  --text-invert: var(--dc-ink) !important;
  --chat-text-muted: var(--dc-secondary) !important;
  --input-text-default: var(--dc-text) !important;
  --input-text-error-default: var(--dc-text) !important;
  --input-placeholder-text-default: var(--dc-secondary) !important;
  --channel-text-area-placeholder: var(--dc-secondary) !important;
  --input-icon-default: var(--dc-secondary) !important;
  --input-background-default: var(--dc-hover) !important;
  --input-background-error-default: var(--dc-hover) !important;
  --input-border-default: var(--dc-border) !important;
  --input-border-readonly: var(--dc-border) !important;
  --input-border-hover: var(--dc-teal) !important;
  --input-border-active: var(--dc-accent) !important;
  --input-border-error-default: $error_on_blue !important;
  --text-link: $info !important;
  --text-brand: $accent_on_blue !important;
  --text-positive: $success !important;
  --text-warning: $warning_on_blue !important;
  --text-danger: $error_on_blue !important;
  --header-primary: var(--dc-text) !important;
  --header-secondary: var(--dc-secondary) !important;
  --channels-default: var(--dc-secondary) !important;
  --channel-icon: var(--dc-secondary) !important;
  --interactive-normal: var(--dc-secondary) !important;
  --interactive-hover: var(--dc-text) !important;
  --interactive-active: var(--dc-text) !important;
  --interactive-muted: var(--dc-muted) !important;
  --interactive-text-default: var(--dc-secondary) !important;
  --interactive-text-hover: var(--dc-text) !important;
  --interactive-text-active: var(--dc-text) !important;
  --icon-primary: var(--dc-text) !important;
  --icon-secondary: var(--dc-secondary) !important;
  --icon-tertiary: var(--dc-muted) !important;

  --brand-experiment: var(--dc-accent) !important;
  --brand-500: var(--dc-accent) !important;
  --brand-560: var(--dc-accent) !important;
  --brand-600: var(--dc-teal) !important;
  --brand-700: var(--dc-teal) !important;
  --control-brand-foreground: $accent_on_blue !important;
  --control-brand-foreground-new: $accent_on_blue !important;
  --button-filled-brand-background: var(--dc-accent) !important;
  --button-filled-brand-background-hover: var(--dc-teal) !important;
  --button-filled-brand-background-active: var(--dc-teal) !important;
  --button-filled-brand-text: var(--dc-ink) !important;
  --button-secondary-background: var(--dc-hover) !important;
  --button-secondary-background-hover: var(--dc-selected) !important;
  --button-secondary-text: var(--dc-text) !important;
  --button-positive-background: $success !important;
  --button-positive-text: var(--dc-ink) !important;
  --button-danger-background: $error !important;
  --button-danger-text: var(--dc-text) !important;
  --status-positive: $success !important;
  --status-warning: $warning_on_blue !important;
  --status-danger: $error_on_blue !important;
  --text-feedback-positive: $success !important;
  --text-feedback-info: $info !important;
  --text-feedback-warning: $warning_on_blue !important;
  --text-feedback-critical: $error_on_blue !important;
  --text-status-online: $success !important;
  --text-status-idle: $warning_on_blue !important;
  --text-status-dnd: $error_on_blue !important;
  --text-status-offline: var(--dc-muted) !important;
  --text-voice-connected: $success !important;
  --text-voice-speaking: $success !important;
  --text-voice-disconnected: $error_on_blue !important;

  --checkbox-background-default: var(--dc-hover) !important;
  --checkbox-background-hover: var(--dc-selected) !important;
  --checkbox-background-active: var(--dc-accent) !important;
  --checkbox-background-selected-default: var(--dc-accent) !important;
  --checkbox-background-selected-hover: var(--dc-teal) !important;
  --checkbox-border-default: var(--dc-border) !important;
  --checkbox-border-hover: var(--dc-teal) !important;
  --checkbox-border-active: var(--dc-accent) !important;
  --checkbox-border-selected-default: var(--dc-accent) !important;
  --checkbox-border-selected-hover: var(--dc-teal) !important;
  --checkbox-icon-active: var(--dc-ink) !important;
  --radio-background-default: var(--dc-hover) !important;
  --radio-background-hover: var(--dc-selected) !important;
  --radio-background-active: var(--dc-accent) !important;
  --radio-background-selected-default: var(--dc-accent) !important;
  --radio-background-selected-hover: var(--dc-teal) !important;
  --radio-border-default: var(--dc-border) !important;
  --radio-border-hover: var(--dc-teal) !important;
  --radio-border-active: var(--dc-accent) !important;
  --radio-border-selected-default: var(--dc-accent) !important;
  --radio-border-selected-hover: var(--dc-teal) !important;
  --radio-foreground-default: var(--dc-text) !important;
  --radio-foreground-hover: var(--dc-text) !important;
  --radio-foreground-active: var(--dc-ink) !important;
  --radio-thumb-background-active: var(--dc-ink) !important;

  --reaction-text-default: var(--dc-secondary) !important;
  --reaction-text-reacted-default: var(--dc-text) !important;
  --reaction-text-active: var(--dc-text) !important;
  --reaction-background: var(--dc-hover) !important;
  --reaction-background-selected: var(--dc-selected) !important;
  --slider-track-background: var(--dc-hover) !important;
  --progressbar-indicator-background: var(--dc-accent) !important;

  --border-subtle: var(--dc-border) !important;
  --border-normal: var(--dc-border) !important;
  --border-strong: var(--dc-teal) !important;
  --border-faint: var(--dc-border) !important;
  --divider-subtle: var(--dc-border) !important;
  --scrollbar-thin-thumb: var(--dc-teal) !important;
  --scrollbar-thin-track: transparent !important;
  --scrollbar-auto-thumb: var(--dc-teal) !important;
  --scrollbar-auto-track: var(--dc-background) !important;
  --scrollbar-auto-scrollbar-color-thumb: var(--dc-teal) !important;
  --scrollbar-auto-scrollbar-color-track: var(--dc-background) !important;
  --font-primary: "Noto Sans", sans-serif;
  --font-display: "Noto Sans", sans-serif;
  --font-code: "JetBrainsMono Nerd Font", monospace;
}
